DATABASE_PROVIDER="prisma"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repair_manager?schema=public"

# Pour Vercel sans Postgres, utilisez Firebase :
# DATABASE_PROVIDER="firebase"
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Generez au minimum 32 octets aleatoires, par exemple : openssl rand -hex 32
AUTH_SECRET="replace-with-at-least-64-random-hex-characters"
# Cle distincte recommandee pour les secrets stockes en base.
DATA_ENCRYPTION_KEY="replace-with-another-64-random-hex-characters"
ADMIN_EMAIL="admin@exemple.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
NEXT_PUBLIC_APP_URL="https://www.qoravo.fr"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Code exceptionnel donnant un compte sans paiement. Laisser vide pour le desactiver.
FREE_ACCESS_CODE=""

# SMTP serveur utilise pour les codes de creation/connexion.
# Ports autorises par securite : 465, 587 ou 2525.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER="lrt.service.client@gmail.com"
SMTP_PASSWORD=""
SMTP_FROM="lrt.service.client@gmail.com"
SMTP_SECURE="false"
SUPPORT_EMAIL="lrt.service.client@gmail.com"
GOOGLE_REVIEW_URL=""

# Protege la route cron des relances (32 caracteres aleatoires minimum).
CRON_SECRET=""

# Acces moderateur distinct de l'administration des ateliers.
MODERATOR_EMAIL=""
MODERATOR_PASSWORD=""
MODERATOR_SECRET="replace-with-another-64-character-random-secret"
# Action exceptionnelle et destructive. Laisser a false en exploitation normale.
ALLOW_MODERATOR_DATABASE_RESET="false"

SHOP_NAME="Nom du magasin"
SHOP_ADDRESS="Adresse du magasin"
SHOP_OPENING_HOURS="Horaires d'ouverture"
SHOP_PHONE="Telephone du magasin"
