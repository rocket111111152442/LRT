# Concept de refonte Neho — variables d'environnement
# Aucun secret réel ne doit être committé. Copier ce fichier en .env.local.

# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://neho-redesign-demo.vercel.app"

# --- Formulaires (contact, estimation, demande de visite) ---
# Service d'envoi transactionnel (Resend recommandé, cohérent avec les autres
# sites du dépôt). Tant que ces variables sont absentes, les formulaires
# valident et journalisent la demande côté serveur mais n'envoient pas
# d'e-mail réel : aucune fausse confirmation n'est affichée à l'utilisateur.
RESEND_API_KEY=""
CONTACT_FROM="site@neho-redesign-demo.example"
CONTACT_TO="contact@neho-redesign-demo.example"

# --- Anti-spam / rate limiting ---
# Optionnel : jeton pour un service de vérification (ex. Turnstile/hCaptcha).
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Cartographie ---
# Nécessaire uniquement si l'on branche un fournisseur de carte réel
# (MapLibre + tuiles vectorielles suisses, ou Mapbox). La carte de démo
# utilise un SVG stylisé de la Suisse sans dépendance externe.
NEXT_PUBLIC_MAP_TILES_URL=""

# --- Futur moteur d'estimation / API biens ---
# À renseigner lorsqu'une vraie source de données (API Neho ou CRM interne)
# est autorisée. Voir docs/neho-audit.md et src/lib/data/README.md.
REAL_ESTATE_API_URL=""
REAL_ESTATE_API_KEY=""

# --- Analytics (facultatif, respectueux de la vie privée) ---
NEXT_PUBLIC_ANALYTICS_ID=""

# --- Vérification propriété moteurs de recherche (facultatif) ---
GOOGLE_SITE_VERIFICATION=""
