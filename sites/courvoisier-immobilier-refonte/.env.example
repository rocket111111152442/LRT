# URL publique du site (utilisée pour les canonicals, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.courvoisier.immo

# Envoi des formulaires (contact, estimation, demande de visite) via Resend.
# Sans ces trois variables, les demandes sont validées et journalisées côté
# serveur mais aucun e-mail n'est réellement envoyé — voir README.md.
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
