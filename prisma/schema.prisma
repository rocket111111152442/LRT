generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RepairStatus {
  PAS_ENCORE_EN_REPARATION
  EN_REPARATION
  EN_ATTENTE_PIECE
  PRET
  RECUPERE
  ANNULE
}

enum UserRole {
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

model Repair {
  id               String       @id @default(cuid())
  proAccountId     String?
  proAccount       ProAccount?  @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String
  email            String
  deviceType       String
  brand            String
  model            String
  issueDescription String
  unlockCodeOrNote String?
  status           RepairStatus @default(PAS_ENCORE_EN_REPARATION)
  internalNotes    String?
  readyEmailSent   Boolean      @default(false)
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([proAccountId])
}

model User {
  id           String      @id @default(cuid())
  proAccountId String?
  proAccount   ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  email        String      @unique
  passwordHash String
  role         UserRole    @default(ADMIN)
  createdAt    DateTime    @default(now())
}

model ProAccount {
  id                        String        @id @default(cuid())
  companyName               String
  slug                      String        @unique
  ownerEmail                String        @unique
  firebaseApiKey            String
  firebaseAuthDomain        String
  firebaseProjectId         String
  firebaseStorageBucket     String?
  firebaseMessagingSenderId String?
  firebaseAppId             String
  paymentStatus             PaymentStatus @default(PENDING)
  stripeSessionId           String?
  users                     User[]
  repairs                   Repair[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
}

model PendingProSignup {
  id                        String   @id @default(cuid())
  stripeSessionId           String?  @unique
  companyName               String
  slug                      String
  ownerEmail                String
  passwordHash              String
  firebaseApiKey            String
  firebaseAuthDomain        String
  firebaseProjectId         String
  firebaseStorageBucket     String?
  firebaseMessagingSenderId String?
  firebaseAppId             String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([ownerEmail])
  @@index([slug])
}

model EmailVerificationCode {
  id        String   @id
  email     String
  purpose   String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, purpose])
}

model EmailSettings {
  id               String   @id @default("default")
  smtpEmail        String?
  smtpAppPassword  String?
  smtpHost         String   @default("smtp.gmail.com")
  smtpPort         Int      @default(465)
  smtpSecure       Boolean  @default(true)
  smtpFromName     String?
  shopName         String?
  shopAddress      String?
  shopOpeningHours String?
  shopPhone        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
