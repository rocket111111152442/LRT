generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RepairStatus {
  PAS_ENCORE_RECU_CLIENT
  PAS_ENCORE_EN_REPARATION
  EN_REPARATION
  EN_ATTENTE_PIECE
  PRET
  RECUPERE
  ANNULE
}

enum UserRole {
  ADMIN
}

enum PaymentStatus {
  PENDING
  TRIAL
  PAID
  CANCELED
}

enum QuoteStatus {
  NONE
  SENT
  ACCEPTED
  REFUSED
}

enum PartStatus {
  NONE
  ORDERED
  RECEIVED
  INSTALLED
}

enum RepairPaymentStatus {
  NON_PAYE
  ACOMPTE
  PAYE
  REMBOURSE
}

enum CustomerType {
  STANDARD
  VIP
  PRO
}

model Repair {
  id               String       @id @default(cuid())
  proAccountId     String?
  proAccount       ProAccount?  @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  ticketNumber     String?      @unique
  firstName        String
  lastName         String
  phone            String
  email            String
  deviceType       String
  brand            String
  model            String
  issueDescription String
  unlockCodeOrNote String?
  status           RepairStatus @default(PAS_ENCORE_EN_REPARATION)
  internalNotes    String?
  readyEmailSent   Boolean      @default(false)
  smsReadySent      Boolean      @default(false)
  reviewEmailSent   Boolean      @default(false)
  reviewToken        String?      @unique
  reviewRespondedAt  DateTime?
  readyReminderSentAt DateTime?
  urgent           Boolean      @default(false)
  expressMode      Boolean      @default(false)
  estimatedPriceCents Int?
  partsCostCents  Int?
  paidAmountCents Int          @default(0)
  depositCents    Int          @default(0)
  paymentStatus   RepairPaymentStatus @default(NON_PAYE)
  warrantyUntil   DateTime?
  warrantyReturn  Boolean      @default(false)
  expectedPickupAt DateTime?
  technicianName  String?
  timeSpentMinutes Int         @default(0)
  checklistDiagnostic Boolean  @default(false)
  checklistBackup Boolean      @default(false)
  checklistFunctionalTest Boolean @default(false)
  checklistCleaning Boolean    @default(false)
  customerType    CustomerType @default(STANDARD)
  satisfactionRating Int?
  satisfactionComment String?
  supplierOrderNote String?
  partsUsed       String?
  usedInventoryItemId String?
  usedInventoryItemName String?
  usedInventoryQuantity Int    @default(0)
  quoteStatus      QuoteStatus  @default(NONE)
  quoteToken       String?      @unique
  quoteSentAt      DateTime?
  quoteRespondedAt DateTime?
  photos           String[]     @default([])
  customerDropOffSignature String?
  customerPickupSignature String?
  partsStatus      PartStatus   @default(NONE)
  partsDescription String?
  archivedAt       DateTime?
  events           RepairEvent[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([expectedPickupAt])
  @@index([urgent])
  @@index([customerType])
  @@index([proAccountId])
  @@index([ticketNumber])
  @@index([quoteToken])
  @@index([reviewToken])
}

model User {
  id           String      @id @default(cuid())
  proAccountId String?
  proAccount   ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  email        String      @unique
  passwordHash String
  role         UserRole    @default(ADMIN)
  createdAt    DateTime    @default(now())
}

model ProAccount {
  id                        String        @id @default(cuid())
  companyName               String
  slug                      String        @unique
  ownerEmail                String        @unique
  firebaseApiKey            String
  firebaseAuthDomain        String
  firebaseProjectId         String
  firebaseStorageBucket     String?
  firebaseMessagingSenderId String?
  firebaseAppId             String
  publicDescription         String?
  publicPhone               String?
  publicAddress             String?
  shopAddress               String?
  shopPostalCode            String?
  shopCity                  String?
  shopCountry               String?
  shopPhone                 String?
  shopEmail                 String?
  shopOpeningHours          String?
  shopLatitude              Float?
  shopLongitude             Float?
  shopCapacityPerDay        Int           @default(8)
  shopSlotDurationMinutes   Int           @default(60)
  shopMaxAppointmentsPerSlot Int          @default(1)
  monthlyGoal               Int           @default(100)
  referralCode              String?
  supportIncluded           Boolean       @default(false)
  plan                      String        @default("basic")
  storageAddonGb            Int           @default(0)
  paymentStatus             PaymentStatus @default(PENDING)
  trialEndsAt               DateTime?
  stripeSessionId           String?
  users                     User[]
  repairs                   Repair[]
  inventoryItems            InventoryItem[]
  setupAppointments         SetupAppointment[]
  accountingSettings        AccountingSettings?
  accountingSales           AccountingSale[]
  accountingExpenses        AccountingExpense[]
  accountingEmployees       AccountingEmployee[]
  accountingPayrollEntries  AccountingPayrollEntry[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
}

model RepairEvent {
  id           String   @id @default(cuid())
  repairId     String
  repair       Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  proAccountId String?
  type         String
  message      String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([repairId])
  @@index([proAccountId])
  @@index([createdAt])
}

model SupportMessage {
  id           String   @id @default(cuid())
  proAccountId String?
  name         String
  email        String
  subject      String
  message      String
  offre        String?
  status       String   @default("OPEN")
  moderatorNote String?
  createdAt    DateTime @default(now())

  @@index([proAccountId])
  @@index([status])
  @@index([createdAt])
}

model EmailContact {
  id           String   @id @default(cuid())
  proAccountId String?
  email        String
  name         String?
  company      String?
  status       String   @default("SUBSCRIBED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([proAccountId])
  @@index([email])
  @@index([status])
}

model InventoryItem {
  id                String      @id @default(cuid())
  proAccountId      String?
  proAccount        ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  name              String
  category          String      @default("PIECE")
  reference         String?
  quantity          Int         @default(0)
  lowStockThreshold Int         @default(1)
  unitCostCents     Int         @default(0)
  unitPriceCents    Int         @default(0)
  supplier          String?
  location          String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([proAccountId])
  @@index([name])
  @@index([category])
}

model PendingProSignup {
  id                        String   @id @default(cuid())
  stripeSessionId           String?  @unique
  companyName               String
  slug                      String
  ownerEmail                String
  passwordHash              String
  firebaseApiKey            String
  firebaseAuthDomain        String
  firebaseProjectId         String
  firebaseStorageBucket     String?
  firebaseMessagingSenderId String?
  firebaseAppId             String
  shopAddress               String?
  shopPostalCode            String?
  shopCity                  String?
  shopCountry               String?
  shopPhone                 String?
  shopEmail                 String?
  shopOpeningHours          String?
  shopLatitude              Float?
  shopLongitude             Float?
  shopCapacityPerDay        Int           @default(8)
  shopSlotDurationMinutes   Int           @default(60)
  shopMaxAppointmentsPerSlot Int          @default(1)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([ownerEmail])
  @@index([slug])
}

model EmailVerificationCode {
  id        String   @id
  email     String
  purpose   String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, purpose])
}

model EmailSettings {
  id               String   @id @default("default")
  smtpEmail        String?
  smtpAppPassword  String?
  smtpHost         String   @default("smtp.gmail.com")
  smtpPort         Int      @default(465)
  smtpSecure       Boolean  @default(true)
  smtpFromName     String?
  shopName         String?
  shopAddress      String?
  shopOpeningHours String?
  shopPhone        String?
  googleReviewUrl  String?
  createdEmailTemplate String?
  statusEmailTemplate String?
  quoteEmailTemplate String?
  reviewEmailTemplate String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SetupAppointment {
  id              String      @id @default(cuid())
  proAccountId    String?
  proAccount      ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  stripeSessionId String      @unique
  companyName     String
  ownerEmail      String
  requestedAt     DateTime
  contactPhone    String?
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([proAccountId])
  @@index([requestedAt])
  @@index([ownerEmail])
}

model PublicReview {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([rating])
}

model AccountingSettings {
  id                          String      @id @default(cuid())
  proAccountId                String?     @unique
  proAccount                  ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  country                     String      @default("FR")
  currency                    String      @default("EUR")
  vatEnabled                  Boolean     @default(true)
  defaultVatRateBps           Int         @default(2000)
  incomeTaxRateBps            Int         @default(1500)
  socialContributionRateBps   Int         @default(2200)
  employerContributionRateBps Int         @default(4200)
  fiscalYearStartMonth        Int         @default(1)
  notes                       String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  @@index([proAccountId])
}

model AccountingSale {
  id             String      @id @default(cuid())
  proAccountId   String?
  proAccount     ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  soldAt         DateTime    @default(now())
  customerName   String?
  label          String
  category       String      @default("AUTRE")
  quantity       Int         @default(1)
  unitPriceCents Int
  unitCostCents  Int         @default(0)
  vatRateBps     Int         @default(2000)
  paymentMethod  String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([proAccountId])
  @@index([soldAt])
  @@index([category])
}

model AccountingExpense {
  id                 String      @id @default(cuid())
  proAccountId       String?
  proAccount         ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  spentAt            DateTime    @default(now())
  label              String
  category           String      @default("AUTRE")
  amountCents        Int
  deductibleVatCents Int         @default(0)
  supplier           String?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([proAccountId])
  @@index([spentAt])
  @@index([category])
}

model AccountingEmployee {
  id                       String                   @id @default(cuid())
  proAccountId             String?
  proAccount               ProAccount?              @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  firstName                String
  lastName                 String
  role                     String?
  contractType             String?
  grossMonthlySalaryCents  Int                      @default(0)
  employerContributionRateBps Int?
  active                   Boolean                  @default(true)
  payrollEntries           AccountingPayrollEntry[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([proAccountId])
  @@index([active])
  @@index([lastName])
}

model AccountingPayrollEntry {
  id                          String              @id @default(cuid())
  proAccountId                String?
  proAccount                  ProAccount?          @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  employeeId                  String
  employee                    AccountingEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart                 DateTime
  periodEnd                   DateTime
  grossSalaryCents            Int
  employerContributionsCents  Int
  netPaidCents                Int
  notes                       String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@index([proAccountId])
  @@index([employeeId])
  @@index([periodStart])
}
