generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RepairStatus {
  PAS_ENCORE_EN_REPARATION
  EN_REPARATION
  EN_ATTENTE_PIECE
  PRET
  RECUPERE
  ANNULE
}

enum UserRole {
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

enum QuoteStatus {
  NONE
  SENT
  ACCEPTED
  REFUSED
}

enum PartStatus {
  NONE
  ORDERED
  RECEIVED
  INSTALLED
}

enum RepairPaymentStatus {
  NON_PAYE
  ACOMPTE
  PAYE
  REMBOURSE
}

enum CustomerType {
  STANDARD
  VIP
  PRO
}

model Repair {
  id               String       @id @default(cuid())
  proAccountId     String?
  proAccount       ProAccount?  @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  ticketNumber     String?      @unique
  firstName        String
  lastName         String
  phone            String
  email            String
  deviceType       String
  brand            String
  model            String
  issueDescription String
  unlockCodeOrNote String?
  status           RepairStatus @default(PAS_ENCORE_EN_REPARATION)
  internalNotes    String?
  readyEmailSent   Boolean      @default(false)
  smsReadySent      Boolean      @default(false)
  reviewEmailSent   Boolean      @default(false)
  reviewToken        String?      @unique
  reviewRespondedAt  DateTime?
  readyReminderSentAt DateTime?
  urgent           Boolean      @default(false)
  expressMode      Boolean      @default(false)
  estimatedPriceCents Int?
  partsCostCents  Int?
  paidAmountCents Int          @default(0)
  depositCents    Int          @default(0)
  paymentStatus   RepairPaymentStatus @default(NON_PAYE)
  warrantyUntil   DateTime?
  warrantyReturn  Boolean      @default(false)
  expectedPickupAt DateTime?
  technicianName  String?
  timeSpentMinutes Int         @default(0)
  checklistDiagnostic Boolean  @default(false)
  checklistBackup Boolean      @default(false)
  checklistFunctionalTest Boolean @default(false)
  checklistCleaning Boolean    @default(false)
  customerType    CustomerType @default(STANDARD)
  satisfactionRating Int?
  satisfactionComment String?
  supplierOrderNote String?
  partsUsed       String?
  usedInventoryItemId String?
  usedInventoryItemName String?
  usedInventoryQuantity Int    @default(0)
  quoteStatus      QuoteStatus  @default(NONE)
  quoteToken       String?      @unique
  quoteSentAt      DateTime?
  quoteRespondedAt DateTime?
  photos           String[]     @default([])
  customerDropOffSignature String?
  customerPickupSignature String?
  partsStatus      PartStatus   @default(NONE)
  partsDescription String?
  archivedAt       DateTime?
  events           RepairEvent[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([expectedPickupAt])
  @@index([urgent])
  @@index([customerType])
  @@index([proAccountId])
  @@index([ticketNumber])
  @@index([quoteToken])
  @@index([reviewToken])
}

model User {
  id           String      @id @default(cuid())
  proAccountId String?
  proAccount   ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  email        String      @unique
  passwordHash String
  role         UserRole    @default(ADMIN)
  createdAt    DateTime    @default(now())
}

model ProAccount {
  id                        String        @id @default(cuid())
  companyName               String
  slug                      String        @unique
  ownerEmail                String        @unique
  firebaseApiKey            String
  firebaseAuthDomain        String
  firebaseProjectId         String
  firebaseStorageBucket     String?
  firebaseMessagingSenderId String?
  firebaseAppId             String
  publicDescription         String?
  publicPhone               String?
  publicAddress             String?
  shopAddress               String?
  shopPostalCode            String?
  shopCity                  String?
  shopCountry               String?
  shopPhone                 String?
  shopEmail                 String?
  shopOpeningHours          String?
  shopLatitude              Float?
  shopLongitude             Float?
  shopCapacityPerDay        Int           @default(8)
  monthlyGoal               Int           @default(100)
  referralCode              String?
  supportIncluded           Boolean       @default(false)
  paymentStatus             PaymentStatus @default(PENDING)
  stripeSessionId           String?
  users                     User[]
  repairs                   Repair[]
  inventoryItems            InventoryItem[]
  setupAppointments         SetupAppointment[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
}

model RepairEvent {
  id           String   @id @default(cuid())
  repairId     String
  repair       Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  proAccountId String?
  type         String
  message      String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([repairId])
  @@index([proAccountId])
  @@index([createdAt])
}

model InventoryItem {
  id                String      @id @default(cuid())
  proAccountId      String?
  proAccount        ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  name              String
  quantity          Int         @default(0)
  lowStockThreshold Int         @default(1)
  unitCostCents     Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([proAccountId])
  @@index([name])
}

model PendingProSignup {
  id                        String   @id @default(cuid())
  stripeSessionId           String?  @unique
  companyName               String
  slug                      String
  ownerEmail                String
  passwordHash              String
  firebaseApiKey            String
  firebaseAuthDomain        String
  firebaseProjectId         String
  firebaseStorageBucket     String?
  firebaseMessagingSenderId String?
  firebaseAppId             String
  shopAddress               String?
  shopPostalCode            String?
  shopCity                  String?
  shopCountry               String?
  shopPhone                 String?
  shopEmail                 String?
  shopOpeningHours          String?
  shopLatitude              Float?
  shopLongitude             Float?
  shopCapacityPerDay        Int           @default(8)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([ownerEmail])
  @@index([slug])
}

model EmailVerificationCode {
  id        String   @id
  email     String
  purpose   String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, purpose])
}

model EmailSettings {
  id               String   @id @default("default")
  smtpEmail        String?
  smtpAppPassword  String?
  smtpHost         String   @default("smtp.gmail.com")
  smtpPort         Int      @default(465)
  smtpSecure       Boolean  @default(true)
  smtpFromName     String?
  shopName         String?
  shopAddress      String?
  shopOpeningHours String?
  shopPhone        String?
  googleReviewUrl  String?
  createdEmailTemplate String?
  statusEmailTemplate String?
  quoteEmailTemplate String?
  reviewEmailTemplate String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SetupAppointment {
  id              String      @id @default(cuid())
  proAccountId    String?
  proAccount      ProAccount? @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  stripeSessionId String      @unique
  companyName     String
  ownerEmail      String
  requestedAt     DateTime
  contactPhone    String?
  notes           String?
  createdAt       DateTime    @default(now())

  @@index([proAccountId])
  @@index([requestedAt])
  @@index([ownerEmail])
}

model PublicReview {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([rating])
}
