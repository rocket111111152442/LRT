# ---------------------------------------------------------------------------
# NATURAL BRUTAL — variables d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs.
# Ne jamais versionner le `.env` : il contient des secrets.
# ---------------------------------------------------------------------------

# --- Base de données (obligatoire) -----------------------------------------
# PostgreSQL. Sur Vercel : Storage > Postgres (Neon), la variable est injectée
# automatiquement. En local : postgresql://user:mot_de_passe@localhost:5432/naturalbrutal
DATABASE_URL="postgresql://user:password@localhost:5432/naturalbrutal"

# --- Sécurité (obligatoire) -------------------------------------------------
# Clé de signature des sessions. 32 caractères minimum, aléatoire.
# Générer avec :  openssl rand -base64 48
AUTH_SECRET=""

# --- Adresse publique du site ----------------------------------------------
# Sert aux URL de retour Stripe, au sitemap et aux balises SEO.
# Sur Vercel, laisser vide : l'URL du déploiement est détectée automatiquement.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (paiement) ------------------------------------------------------
# Tableau de bord Stripe > Développeurs > Clés API.
# Utiliser les clés de test (sk_test_…) tant que la boutique n'est pas ouverte.
STRIPE_SECRET_KEY=""
# Développeurs > Webhooks > créer un point de terminaison vers
# https://votre-domaine/api/stripe/webhook
# Événements à écouter : checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET=""

# --- Printful (fabrication et expédition) ----------------------------------
# Printful > Paramètres > Développeurs > jeton privé (Bearer).
PRINTFUL_API_KEY=""
# Uniquement si le compte Printful gère plusieurs boutiques.
PRINTFUL_STORE_ID=""
# "false" pour créer les commandes Printful en brouillon et les confirmer à la
# main pendant le lancement. Par défaut, la production démarre automatiquement.
PRINTFUL_AUTO_CONFIRM="true"

# --- Compte administrateur (utilisé par `npm run prisma:seed`) -------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Informations légales (obligatoires pour vendre en France) -------------
# Elles alimentent les mentions légales, les CGV et la page de contact.
# NEXT_PUBLIC_SHOP_LEGAL_NAME : raison sociale exacte si elle diffère du nom
# commercial (ex. « NB Équipement SAS »).
NEXT_PUBLIC_SHOP_LEGAL_NAME=""
NEXT_PUBLIC_SHOP_EMAIL="contact@votre-domaine.fr"
NEXT_PUBLIC_SHOP_PHONE=""
NEXT_PUBLIC_SHOP_ADDRESS=""
NEXT_PUBLIC_SHOP_SIRET=""
NEXT_PUBLIC_SHOP_VAT=""

# --- Réseaux sociaux --------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
